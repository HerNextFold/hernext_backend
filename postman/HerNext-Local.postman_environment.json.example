{
  "name": "HerNext Backend - Local",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "default",
      "enabled": true
    },
    {
      "key": "apiPrefix",
      "value": "/api/v1",
      "type": "default",
      "enabled": true
    },
    {
      "key": "testEmailPrefix",
      "value": "qa.hernext",
      "type": "secret",
      "enabled": true
    },
    {
      "key": "testEmailDomain",
      "value": "your-mailbox.invalid",
      "type": "default",
      "enabled": true,
      "description": "REQUIRED. Set to a domain you can actually read email on (e.g. gmail.com) so the manual OTP step in folders 01 and 03 works."
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Auto-built by the prerequest script of folder 01 registration. Leave blank."
    },
    {
      "key": "testPassword",
      "value": "HerNext-QA-Run-2026!",
      "type": "secret",
      "enabled": true,
      "description": "Password used for the fresh account registered in folder 01. Change it for your run; meets the backend password policy."
    },
    {
      "key": "newPassword",
      "value": "HerNext-QA-New-2026!",
      "type": "secret",
      "enabled": true,
      "description": "Used by the password-reset flow (folder 03)."
    },
    {
      "key": "demoEmail",
      "value": "aisha.demo@hernext.africa",
      "type": "default",
      "enabled": true,
      "description": "Seeded demo participant for the fast, no-OTP regression mode (folders 00, 02, 05-13)."
    },
    {
      "key": "demoPassword",
      "value": "AishaDemo123!",
      "type": "secret",
      "enabled": true,
      "description": "Seeded demo participant password (db:seed:demo). Demo-only credential, not a real secret."
    },
    {
      "key": "participantBEmail",
      "value": "amina.demo@hernext.africa",
      "type": "default",
      "enabled": true,
      "description": "Second demo participant (db:seed:demo:org) used by folder 12 to prove tenant isolation. Logs in and gets participantBToken."
    },
    {
      "key": "targetCareerId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Optional override. If empty, the collection captures recommendedCareerId from GET /careers/recommendations and uses it for profile + roadmap generation."
    },
    {
      "key": "emailOtp",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "MANUAL OTP. Paste the 6-digit code from your real mailbox when you run folder 01 (email verification). Blank by default."
    },
    {
      "key": "resetOtp",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "MANUAL OTP. Paste the 6-digit code from your real mailbox when you run folder 03 (password reset). Blank by default."
    }
  ],
  "_postman_variable_scope": "environment"
}