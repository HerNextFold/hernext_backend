# Server
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_SSL=true
# Max clients in the shared pool. Lower when a hosted Neon branch has a small
# connection limit or several processes (dev server + tests) share the branch.
DB_POOL_MAX=10

# Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# AI (optional)
# Provider is Google Gemini via Google AI Studio by default.
# AI_PROVIDER=gemini            # or 'openai-compatible'
AI_API_KEY=
AI_MODEL=

# Email (OTP delivery for email verification + password reset)
# 'test' captures OTP emails in memory (dev/test/QA only). Production must
# use 'brevo' and never the in-memory test provider.
EMAIL_PROVIDER=test
# EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=HerNext

# Logging
LOG_LEVEL=info