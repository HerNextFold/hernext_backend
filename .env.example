# Server
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_SSL=true
# Max clients in the shared pool. Lower when a hosted Neon branch has a small
# connection limit or several processes (dev server + tests) share the branch.
DB_POOL_MAX=10

# Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# AI (optional)
# Default provider is Groq (OpenAI-compatible Chat Completions, JSON Object
# Mode). Get a free key at https://console.groq.com/keys - never commit it.
AI_PROVIDER=groq
GROQ_API_KEY=
# Recommended default model (see docs/AI_SPEC.md §43 for the rationale).
AI_MODEL=openai/gpt-oss-120b

# Alternative providers (only used when AI_PROVIDER is changed):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.6-flash
# AI_API_KEY=
# AI_API_KEY is a legacy alias honoured by the OpenAI-compatible path when
# OPENAI_API_KEY is unset (e.g. existing Gemini deployments). Never commit a
# real key.

# Email (OTP delivery for email verification + password reset)
# 'test' captures OTP emails in memory (dev/test/QA only). Production must
# use 'brevo' and never the in-memory test provider.
EMAIL_PROVIDER=test
# EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=HerNext

# Logging
LOG_LEVEL=info